test/ssl-tests/04-client_auth.cnf.in:# -*- mode: perl; -*-
test/ssl-tests/04-client_auth.cnf.in:# We test version-flexible negotiation (undef) and each protocol version.
test/ssl-tests/04-client_auth.cnf.in:                # Sanity-check simple handshake.
test/ssl-tests/04-client_auth.cnf.in:                    name => "server-auth-${protocol_name}"
test/ssl-tests/04-client_auth.cnf.in:                            .($sctp ? "-sctp" : ""),
test/ssl-tests/04-client_auth.cnf.in:                $tests[-1]{"test"}{"UseSCTP"} = "Yes" if $sctp;
test/ssl-tests/04-client_auth.cnf.in:                    name => "client-auth-${protocol_name}-request"
test/ssl-tests/04-client_auth.cnf.in:                            .($sctp ? "-sctp" : ""),
test/ssl-tests/04-client_auth.cnf.in:                $tests[-1]{"test"}{"UseSCTP"} = "Yes" if $sctp;
test/ssl-tests/04-client_auth.cnf.in:                    name => "client-auth-${protocol_name}-require-fail"
test/ssl-tests/04-client_auth.cnf.in:                            .($sctp ? "-sctp" : ""),
test/ssl-tests/04-client_auth.cnf.in:                        "VerifyCAFile" => test_pem("root-cert.pem"),
test/ssl-tests/04-client_auth.cnf.in:                $tests[-1]{"test"}{"UseSCTP"} = "Yes" if $sctp;
test/ssl-tests/04-client_auth.cnf.in:                    name => "client-auth-${protocol_name}-require"
test/ssl-tests/04-client_auth.cnf.in:                             .($sctp ? "-sctp" : ""),
test/ssl-tests/04-client_auth.cnf.in:                        "VerifyCAFile" => test_pem("root-cert.pem"),
test/ssl-tests/04-client_auth.cnf.in:                        "Certificate" => test_pem("ee-client-chain.pem"),
test/ssl-tests/04-client_auth.cnf.in:                        "PrivateKey"  => test_pem("ee-key.pem"),
