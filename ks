crypto/aes/asm/aes-mips.pl:	    s/_xtr\s+(\$[0-9]+),(\$[0-9]+),([0-9]+(\-2)*)/
crypto/aes/asm/aes-mips.pl:					:		eval("24-$3"))/e or
crypto/aes/asm/aes-mips.pl:	    s/_ins\s+(\$[0-9]+),(\$[0-9]+),([0-9]+)/
crypto/aes/asm/aes-mips.pl:					:		eval("24-$3"))/e or
crypto/aes/asm/aes-mips.pl:	    s/_ins2\s+(\$[0-9]+),(\$[0-9]+),([0-9]+)/
crypto/aes/asm/aes-mips.pl:					:		eval("24-$3"))/e or
