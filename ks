crypto/aes/asm/aes-mips.pl:					:		eval("$3*-1"))/e or
crypto/aes/asm/aes-mips.pl:	    s/_bias\s+(\$[0-9]+),(\$[0-9]+),([0-9]+)/
crypto/aes/asm/aes-mips.pl:					:		eval("($3-16)&31"))/e;
