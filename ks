config.com:$	! -32 or 32	sets /POINTER_SIZE=32
config.com:$	! -64 or 64	sets /POINTER_SIZE=64
config.com:$	! -d		sets debugging
config.com:$	! -h		prints a usage and exits
config.com:$	! -t		test mode, doesn't run Configure
config.com:$	here = F$PARSE("A.;",F$ENVIRONMENT("PROCEDURE"),,,"SYNTAX_ONLY") - "A.;"
config.com:$	    IF P .EQS. "-h"
config.com:  -32 or 32	Build with 32-bit pointer size.
config.com:  -64 or 64	Build with 64-bit pointer size.
config.com:  -d		Build with debugging.
config.com:  -t            Test mode, do not run the Configure perl script.
config.com:  -v            Verbose mode, show the exact Configure call that is being made.
config.com:  -h		This help.
config.com:$	    IF P .EQS. "-t"
config.com:$	    IF P .EQS. "-v"
config.com:$	    IF P .EQS. "-32" .OR. P .EQS. "32"
config.com:$		pointer_size = "-P32"
config.com:$	    IF P .EQS. "-64" .OR. P .EQS. "64"
config.com:$		pointer_size = "-P64"
config.com:$	    IF P .EQS. "-d"
config.com:$               collected_args = collected_args + " --debug"
config.com:$	    IF P .NES. "" THEN -
config.com:$	target = "vms-''arch'''pointer_size'"
config.com:$       IF verbose THEN -
config.com:$       IF .not. dryrun THEN -
